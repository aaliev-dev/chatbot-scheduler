{
  "name": "chatbot-scheduler",
  "displayName": "Chat Bot Scheduler",
  "description": "Telegram-style scheduled messages for VS Code Copilot Chat — delay any chat message by 15 minutes to 3 hours with a clock button, and it lands back in the same conversation",
  "version": "0.4.2",
  "publisher": "aliwodan",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Chat",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "chatbot.scheduler",
        "name": "bot",
        "displayName": "Chat Bot Scheduler",
        "fullName": "Chat Bot Scheduler",
        "description": "Custom chat agent with delayed (Telegram-style) message scheduling",
        "isSticky": true,
        "commands": [
          {
            "name": "schedule",
            "description": "Schedule a delayed message: /schedule in 2h :: your message"
          },
          {
            "name": "list",
            "description": "List scheduled messages"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "chatbot.scheduleMessage",
        "title": "Chat Bot Scheduler: Schedule Message"
      },
      {
        "command": "chatbot.listSchedules",
        "title": "Chat Bot Scheduler: Show Scheduled Messages"
      },
      {
        "command": "chatbot.insertSchedule",
        "title": "Schedule message",
        "icon": "$(clock)"
      }
    ],
    "menus": {
      "chat/input/status": [
        {
          "command": "chatbot.insertSchedule",
          "when": "chatIsEnabled",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "chatbot.insertSchedule",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "chatbot.insertSchedule",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "chatIsEnabled"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.4.0"
  }
}
